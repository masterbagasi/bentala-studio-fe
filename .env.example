# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
#
# IMPORTANT: bentala-studio MUST use the SAME Supabase project as bentala-nextjs
# (the internal system). Do not create a separate Supabase project.

# Public — safe to expose in browser bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — used by /api/leads/submit and /api/track for privileged operations.
# NEVER prefix this with NEXT_PUBLIC_ and never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
